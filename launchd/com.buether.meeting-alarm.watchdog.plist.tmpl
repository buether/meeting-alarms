<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buether.meeting-alarm.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>@REPO@/build/MeetingAlarm.app/Contents/MacOS/meeting-alarm-launcher</string>
    <string>@PYTHON@</string>
    <string>@REPO@/meeting_alarm.py</string>
    <string>watchdog</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>14</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
  </array>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/meeting-alarm/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/meeting-alarm/launchd.log</string>
</dict>
</plist>
